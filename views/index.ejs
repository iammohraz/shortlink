<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%- include("./components/head.ejs"); -%>
    <title><%= appname %></title>
  </head>
  <body>
    <%- include("./components/navbar.ejs"); -%>
    <div>
      <div class="container d-flex justify-content-center">
        <div style="margin-top: 60px; width: 800px" class="text-center">
          <div class="d-flex justify-content-center">
            <div>
              <h1>Create ShortLink Now!</h1>
              <hr />
            </div>
          </div>
          <form method="post" action="/create">
            <input
              class="form-control form-control-lg rounded-4 mb-2"
              type="text"
              name="link"
              placeholder="https://example.com/"
            />
            <button class="btn btn-primary btn-lg rounded-4" type="submit">
              Create
            </button>
          </form>
          <% if (errors.length > 0) {%>
          <div class="alert alert-danger border-danger text-start rounded-4">
            <ul class="m-0">
              <% errors.forEach((error)=>{ %>
              <li><%= error.msg %></li>
              <% }) %>
            </ul>
          </div>
          <% } %> <% if (create.length > 0) {%>
          <div class="alert alert-success border-success rounded-4">
            Your ShortLink (Click to Copy) :
            <span
              ><button
                id="btncopy"
                type="button"
                class="btn btn-primary ms-1 mt-2 mt-md-0"
              >
                <%= create %>
              </button>
            </span>
          </div>
          <% } %>
          <div style="margin-top: 100px">
            <a
              class="p-3 rounded-4 d-flex text-white align-items-center btn btn-primary shadow mb-3"
              href="analyze"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="34"
                height="34"
                fill="currentColor"
                class="bi bi-bar-chart-fill me-3 mb-1"
                viewBox="0 0 16 16"
              >
                <path
                  d="M1 11a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1v-3zm5-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7zm5-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V2z"
                />
              </svg>
              <h3>Analyze Your Link</h3>
            </a>
            <a
              class="p-3 rounded-4 d-flex text-white align-items-center btn btn-secondary shadow"
              href="/about"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="34"
                height="34"
                fill="currentColor"
                class="bi bi-person-bounding-box me-3 mb-1"
                viewBox="0 0 16 16"
              >
                <path
                  d="M1.5 1a.5.5 0 0 0-.5.5v3a.5.5 0 0 1-1 0v-3A1.5 1.5 0 0 1 1.5 0h3a.5.5 0 0 1 0 1h-3zM11 .5a.5.5 0 0 1 .5-.5h3A1.5 1.5 0 0 1 16 1.5v3a.5.5 0 0 1-1 0v-3a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 1-.5-.5zM.5 11a.5.5 0 0 1 .5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 1 0 1h-3A1.5 1.5 0 0 1 0 14.5v-3a.5.5 0 0 1 .5-.5zm15 0a.5.5 0 0 1 .5.5v3a1.5 1.5 0 0 1-1.5 1.5h-3a.5.5 0 0 1 0-1h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 1 .5-.5z"
                />
                <path
                  d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H3zm8-9a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"
                />
              </svg>
              <h3>About</h3>
            </a>
          </div>
        </div>
      </div>
    </div>
    <script>
      var text = document.getElementById("btncopy");
      text.addEventListener("click", async function () {
        await navigator.clipboard.writeText(text.textContent);
      });
    </script>
  </body>
</html>
